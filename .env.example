# ---------------------------------------------------------------------------
# Copy to .env.local for local development, and set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# ---------------------------------------------------------------------------

# The site's final address, used for canonical URLs, the sitemap and share
# images. Leave unset on Vercel until the domain is final — the production
# *.vercel.app hostname is used automatically.
NEXT_PUBLIC_SITE_URL=https://zuture.co

# Reservations (/api/notify) are emailed through EmailJS, using the same
# service and product-enquiry template as the live zuture.co enquiry form.
# In the EmailJS dashboard: Account → Security → enable
# "Allow EmailJS API for non-browser applications", then create a private key.
# Without these, the form shows an error rather than silently losing entries.
EMAILJS_SERVICE_ID=service_j9s90s3
EMAILJS_TEMPLATE_ID=template_lcz4hsq
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Optional: Google Search Console verification (the value of the content="…"
# attribute Search Console gives you for the HTML-tag method).
GOOGLE_SITE_VERIFICATION=
