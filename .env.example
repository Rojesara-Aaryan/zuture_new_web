# ---------------------------------------------------------------------------
# Copy to .env.local for local development, and set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# ---------------------------------------------------------------------------

# The site's final address, used for canonical URLs, the sitemap and share
# images. Leave unset on Vercel until the domain is final — the production
# *.vercel.app hostname is used automatically.
NEXT_PUBLIC_SITE_URL=https://zuture.co

# Reservations are emailed from the visitor's browser through EmailJS, with the
# same service and product-enquiry template as the live zuture.co form. They
# work with NOTHING set here: these values are built into src/lib/reservation.ts
# (an EmailJS public key is meant to be public). Set these only to override.
# In EmailJS → Account → Security, add every domain the site runs on to the
# allowed list if domain restrictions are switched on.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_j9s90s3
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_lcz4hsq
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=4LZl370JAA3y8iFQ2

# Optional: Google Search Console verification (the value of the content="…"
# attribute Search Console gives you for the HTML-tag method).
GOOGLE_SITE_VERIFICATION=
